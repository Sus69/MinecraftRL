		"main": [
			"com.arcmenace.minecraftrl.MinecraftRL"
		],
		"client": [
			"com.arcmenace.minecraftrl.client.MinecraftRLClient"
		],
		"fabric-datagen": [
			"com.arcmenace.minecraftrl.client.MinecraftRLDataGenerator"
		]
	},
	"mixins": [
		"minecraft-rl.mixins.json",
		{
			"config": "minecraft-rl.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
